<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Araba Oyunu</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: #111;
            color: #fff;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            overflow: hidden;
        }

        .game-container {
            position: relative;
            width: 400px;
            height: 600px;
            background: #333;
            overflow: hidden;
            border: 4px solid #fff;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
        }

        .road {
            position: absolute;
            width: 100%;
            height: 100%;
            background: #444;
        }

        .line {
            position: absolute;
            width: 10px;
            height: 100px;
            background: #fff;
            left: 50%;
            transform: translateX(-50%);
            animation: moveRoad 0.8s linear infinite;
        }

        .line:nth-child(1) { top: -120px; animation-delay: 0s; }
        .line:nth-child(2) { top: 180px; animation-delay: -0.4s; }
        .line:nth-child(3) { top: 480px; animation-delay: -0.8s; }

        @keyframes moveRoad {
            0% { top: -150px; }
            100% { top: 600px; }
        }

        .car {
            position: absolute;
            width: 50px;
            height: 90px;
            background: #e74c3c;
            bottom: 20px;
            left: 175px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.5);
            transition: left 0.1s ease-out;
        }

        .car::before {
            content: '';
            position: absolute;
            top: 15px;
            left: 5px;
            right: 5px;
            height: 25px;
            background: #3498db;
            border-radius: 4px;
        }
        .car::after {
            content: '';
            position: absolute;
            bottom: 10px;
            left: 5px;
            right: 5px;
            height: 15px;
            background: #2c3e50;
            border-radius: 3px;
        }

        .enemy {
            position: absolute;
            width: 50px;
            height: 90px;
            background: #2ecc71;
            top: -100px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.5);
        }

        .enemy::before {
            content: '';
            position: absolute;
            top: 15px;
            left: 5px;
            right: 5px;
            height: 25px;
            background: #f1c40f;
            border-radius: 4px;
        }

        .score-board {
            position: absolute;
            top: 10px;
            left: 10px;
            font-size: 18px;
            font-weight: bold;
            z-index: 10;
        }

        .game-over {
            display: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 20;
        }

        .game-over h1 {
            font-size: 32px;
            color: #e74c3c;
            margin-bottom: 10px;
        }

        .game-over button {
            padding: 10px 20px;
            font-size: 16px;
            background: #fff;
            border: none;
            cursor: pointer;
            font-family: inherit;
            font-weight: bold;
            border-radius: 5px;
            transition: 0.2s;
        }

        .game-over button:hover {
            background: #ddd;
        }

        .instructions {
            margin-top: 15px;
            font-size: 14px;
            color: #aaa;
        }
    </style>
</head>
<body>

    <div class="game-container">
        <div class="score-board">Skor: <span id="score">0</span></div>
        
        <div class="road">
            <div class="line"></div>
            <div class="line"></div>
            <div class="line"></div>
        </div>

        <div class="car" id="player"></div>
        <div class="enemy" id="enemy"></div>

        <div class="game-over" id="gameOverScreen">
            <h1>OYUN BİTTİ</h1>
            <p>Skorun: <span id="finalScore">0</span></p>
            <br>
            <button onclick="restartGame()">Tekrar Oyna</button>
        </div>
    </div>

    <div class="instructions">Kontroller: <b>Sol / Sağ Ok Tuşları</b></div>

    <script>
        const player = document.getElementById('player');
        const enemy = document.getElementById('enemy');
        const scoreDisplay = document.getElementById('score');
        const gameOverScreen = document.getElementById('gameOverScreen');
        const finalScoreDisplay = document.getElementById('finalScore');

        let playerX = 175;
        let enemyX = getRandomX();
        let enemyY = -150;
        let score = 0;
        let gameSpeed = 5;
        let isGameOver = false;

        document.addEventListener('keydown', (e) => {
            if (isGameOver) return;
            if (e.key === 'ArrowLeft' && playerX > 50) {
                playerX -= 50;
            } else if (e.key === 'ArrowRight' && playerX < 300) {
                playerX += 50;
            }
            player.style.left = playerX + 'px';
        });

        function getRandomX() {
            const lanes = [75, 175, 275];
            return lanes[Math.floor(Math.random() * lanes.length)];
        }

        function updateGame() {
            if (isGameOver) return;

            enemyY += gameSpeed;
            if (enemyY > 600) {
                enemyY = -100;
                enemyX = getRandomX();
                score += 10;
                scoreDisplay.textContent = score;
                
                if (score % 50 === 0) gameSpeed += 1;
            }

            enemy.style.top = enemyY + 'px';
            enemy.style.left = enemyX + 'px';

            if (
                enemyY >= 470 && enemyY <= 570 &&
                Math.abs(playerX - enemyX) < 40
            ) {
                endGame();
            }

            requestAnimationFrame(updateGame);
        }

        function endGame() {
            isGameOver = true;
            gameOverScreen.style.display = 'flex';
            finalScoreDisplay.textContent = score;
        }

        function restartGame() {
            isGameOver = false;
            score = 0;
            gameSpeed = 5;
            enemyY = -100;
            playerX = 175;
            scoreDisplay.textContent = score;
            gameOverScreen.style.display = 'none';
            player.style.left = playerX + 'px';
            updateGame();
        }

        updateGame();
    </script>
</body>
</html>
